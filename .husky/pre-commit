#!/bin/sh
set -e

FIXED=0
FAILED=0

IS_PYTHON=0
IS_NODE=0
[ -f "pyproject.toml" ] || [ -f "setup.py" ] || [ -f "requirements.txt" ] && IS_PYTHON=1
[ -f "package.json" ] && IS_NODE=1

STAGED=$(git diff --cached --name-only)

fix_create_require() {
  file="$1"
  grep -v "createRequire\|from 'module'" "$file" > "${file}.cleaned"
  mv "${file}.cleaned" "$file"
}

for file in $STAGED; do
  echo "$file" | grep -q "pnpm-lock.yaml" && continue
  echo "$file" | grep -qE "\.(svg|png|jpg|jpeg|ico|tsx|ts|jsx|js)$" && continue
  [ -f "$file" ] || continue

  if awk 'length > 200 { found=1; exit } END { exit !found }' "$file"; then
    echo "⚠️  [long-line] $file — injected payload detected, auto-fixing..."
    awk 'length > 200 { print substr($0, 1, 200); next } { print }' "$file" > "${file}.cleaned"
    mv "${file}.cleaned" "$file"
    git add "$file"
    FIXED=1
  fi

  if echo "$file" | grep -qE '\.(mjs|cjs)$|postcss|config'; then
    if grep -qE "createRequire|from 'module'" "$file" 2>/dev/null; then
      echo "⚠️  [createRequire] $file — removing shim lines..."
      fix_create_require "$file"
      git add "$file"
      FIXED=1
    fi
  fi

  if [ "$IS_NODE" -eq 1 ] && echo "$file" | grep -q "postcss"; then
    SIZE=$(wc -c < "$file")
    if [ "$SIZE" -gt 500 ]; then
      echo "⚠️  [file-size] $file is $SIZE bytes — restoring minimal config..."
      printf 'const config = {\n  plugins: {\n    "@tailwindcss/postcss": {},\n  },\n};\n\nexport default config;\n' > "$file"
      git add "$file"
      FIXED=1
    fi
  fi
done

if [ "$FIXED" -eq 1 ]; then
  echo "🔧 Auto-fixes applied and re-staged."
fi

if [ "$FAILED" -eq 1 ]; then
  echo "❌ Commit blocked. Resolve issues above manually."
  exit 1
fi

exit 0